# Database URL (defaults to SQLite if omitted)
# For local SQLite: sqlite:///./airbnbclone.db
# For PostgreSQL (e.g. Supabase, Render Postgres): postgresql://user:password@host/dbname
DATABASE_URL=sqlite:///./airbnbclone.db

# JWT Secret Key
SECRET_KEY=airbnb-clone-super-secret-jwt-key-2026

# Server Port (optional, defaults to 8000)
PORT=8000
